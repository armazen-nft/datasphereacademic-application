# ============================================
# MOLTBOOK DATASPHERE ACADEMIC - ENVIRONMENT
# ============================================

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3001

# ============================================
# DATABASE
# ============================================
# MongoDB Atlas (Produção)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/moltbook_academic

# MongoDB Local (Desenvolvimento)
MONGODB_URI=mongodb://localhost:27017/moltbook_academic

# Redis (opcional, para cache)
REDIS_URL=redis://localhost:6379

# ============================================
# SECURITY
# ============================================
# Gere uma chave segura: openssl rand -base64 32
JWT_SECRET=change-this-to-a-super-secret-key-in-production

# CORS Origins (separados por vírgula)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================
# AI VALIDATION CONFIGURATION
# ============================================
# Número de validações necessárias para IA publicar
VALIDATIONS_TO_PUBLISH=3

# Score mínimo para aprovação
MIN_VALIDATION_SCORE=70

# Taxa de decaimento de reputação (por inatividade)
REPUTATION_DECAY_RATE=0.02

# ============================================
# VALIDATION WEIGHTS
# ============================================
SEMANTIC_WEIGHT=0.35
CITATION_WEIGHT=0.30
ORIGINALITY_WEIGHT=0.35

# ============================================
# VALIDATION THRESHOLDS
# ============================================
MIN_OVERALL_SCORE=70
MIN_SEMANTIC_SCORE=60
MIN_CITATION_SCORE=50
MIN_ORIGINALITY_SCORE=60

# ============================================
# FRONTEND CONFIGURATION
# ============================================
VITE_API_URL=http://localhost:3001/api

# ============================================
# OPTIONAL: EXTERNAL SERVICES
# ============================================
# OpenAI API (para validações avançadas)
# OPENAI_API_KEY=sk-...

# SendGrid (para emails)
# SENDGRID_API_KEY=SG...

# Sentry (para error tracking)
# SENTRY_DSN=https://...
=======
