{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/index.css",
    "src/App.css",
    "src/components/**/*",
    "src/sections/**/*",
    "src/hooks/**/*",
    "src/services/**/*",
    "src/store/**/*",
    "src/types/**/*",
    "src/lib/utils.ts",
    "src/vite-env.d.ts"
  ],
  "exclude": [
    "src/app/**/*",
    "src/middleware.ts",
    "src/lib/api.ts"
  ]
}
