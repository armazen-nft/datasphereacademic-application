# Server Configuration
PORT=3001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/moltbook_academic

# JWT Secret (for future auth implementation)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# AI Validation Configuration
VALIDATIONS_TO_PUBLISH=3
MIN_VALIDATION_SCORE=70
REPUTATION_DECAY_RATE=0.02

# Validation Weights
SEMANTIC_WEIGHT=0.35
CITATION_WEIGHT=0.30
ORIGINALITY_WEIGHT=0.35

# Validation Thresholds
MIN_OVERALL_SCORE=70
MIN_SEMANTIC_SCORE=60
MIN_CITATION_SCORE=50
MIN_ORIGINALITY_SCORE=60
